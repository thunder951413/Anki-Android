                                ],
                                "answer": 0,
                                "hint": "关注合力、质量和加速度的关系。",
                                "explanation": "使用牛顿第二定律 F = ma。题目给的是合力，因此可以直接代入。"
                            },
                            {
                                "id": "formula",
                                "kind": "choice",
                                "prompt": "把 F = ma 变形成求加速度的式子。",
                                "options": [
                                    "a = F/m",
                                    "a = Fm",
                                    "a = m/F"
                                ],
                                "answer": 0,
                                "explanation": "等式两边除以质量 m，得到 a = F/m。"
                            },
                            {
                                "id": "number",
                                "kind": "numeric",
                                "prompt": "代入 4 N 和 2 kg，写出加速度及单位。",
                                "answer": 2,
                                "units": [
                                    "m/s²",
                                    "m/s^2"
                                ],
                                "tolerance": 0.01,
                                "explanation": "a = 4 ÷ 2 = 2 m/s²。数值和单位都需要正确。"
                            }
                        ]
                    }
                },
