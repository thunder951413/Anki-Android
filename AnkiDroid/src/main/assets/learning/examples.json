            "cards": [
                {
                    "id": "ma-equation",
                    "title": "解一元一次方程",
                    "exercise": {
                        "version": 1,
                        "steps": [
                            {
                                "id": "transform",
                                "kind": "choice",
                                "prompt": "解 2x + 3 = 11，首先应怎样变形？",
                                "options": [
                                    "两边同时减去 3",
                                    "只在左边减去 3",
                                    "两边同时加上 3"
                                ],
                                "answer": 0,
                                "explanation": "等式两边做相同运算可保持相等，得到 2x = 8。"
                            },
                            {
                                "id": "solve",
                                "kind": "numeric",
                                "prompt": "由 2x = 8 求 x。",
                                "answer": 4,
                                "tolerance": 0,
                                "explanation": "两边同时除以 2，得到 x = 4。代回原式，2 × 4 + 3 = 11。"
                            }
                        ]
                    }
                },
                {
                    "id": "ma-concept",
                    "title": "平方与平方根",
                    "exercise": {
                        "version": 1,
                        "steps": [
                            {
                                "id": "root",
                                "kind": "multiple",
                                "prompt": "哪些数的平方等于 9？选择所有正确答案。",
                                "options": [
                                    "3",
                                    "−3",
                                    "9",
                                    "0"
                                ],
                                "answer": [
                                    0,
                                    1
                                ],
                                "explanation": "3² = 9，(−3)² = 9。9 的算术平方根是 3，平方根则是 ±3。"
                            }
                        ]
                    }
                }
            ]
        },
